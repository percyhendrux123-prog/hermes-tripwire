{
  "description": "Tripwire: PermissionDenied settings hook for auto mode refusals, and a mod for the refusals settings hooks cannot see",
  "modules": [
    "./register.js"
  ],
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/tripwire_hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
